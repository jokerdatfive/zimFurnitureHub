# ==============================================================================
# KK Furnitures / ZimFurnitureHub Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Direct URL for Supabase Project (used by your Next.js app / Prisma in public schema)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Public API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. Evolution API (Hugging Face Docker Space) Configuration
# ------------------------------------------------------------------------------
# Direct URL to your Hugging Face Space (e.g., https://yourusername-whatsapp-evolution.hf.space)
EVOLUTION_API_URL="https://[YOUR-HF-USERNAME]-[SPACE-NAME].hf.space"

# Global API Key configured in your Hugging Face Space settings (AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY="your-super-secure-evolution-global-api-key-here"

# WhatsApp Instance Name created inside Evolution API
EVOLUTION_INSTANCE_NAME="kkfurnitures-whatsapp"

# REQUIRED. Webhook Security Secret sent by Evolution API (x-webhook-secret header).
# The webhook rejects every request while this is empty.
WEBHOOK_SECRET="whsec_0f9a2b8c4d7e1f5a6b8c9d0e1f2a3b4c"

# Set to "true" to ignore group messages (@g.us) and status broadcasts (status@broadcast)
IGNORE_GROUPS="true"

# ------------------------------------------------------------------------------
# 3. AI Lead Qualification Provider (Vercel AI SDK)
# ------------------------------------------------------------------------------
# Choose provider: 'google' (default, free Gemini Flash) or 'openai' (gpt-4o-mini)
AI_PROVIDER="google"
# Any current Gemini Flash model id; gemini-2.5-flash is a safe default
GEMINI_MODEL="gemini-2.5-flash"

# Google Gemini API Key (get free at https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# OpenAI API Key (optional alternative)
OPENAI_API_KEY="sk-proj-..."

# ------------------------------------------------------------------------------
# 4. App & Keep-Alive Cron Security
# ------------------------------------------------------------------------------
# Public URL of this Next.js app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# REQUIRED. Secret for /api/cron/keepalive and /api/cron/prune (Vercel sends it as a Bearer token).
CRON_SECRET="cron_secret_auth_token_change_me_98765"

# Days to keep chats of IRRELEVANT / SPAM contacts before the nightly prune deletes them
WA_NOISE_RETENTION_DAYS=14

# ------------------------------------------------------------------------------
# 5. WhatsApp Webhook & Verification (Meta / Dualhook Coexistence)
# ------------------------------------------------------------------------------
VERIFY_TOKEN=your_verify_token_here
WEBHOOK_KEY=your_secret_key_here
META_APP_SECRET=your_meta_app_secret_here

# Client Business WhatsApp Phone Number (e.g. 263770000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=263770000000

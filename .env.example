# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# WhatsApp Webhook & Verification
# VERIFY_TOKEN is the hub.verify_token configured in Meta/Dualhook
VERIFY_TOKEN=your_verify_token_here
# Optional extra query key or secret: ?key=your_secret_key
WEBHOOK_KEY=your_secret_key_here
# Optional Meta App Secret for X-Hub-Signature-256 HMAC verification
META_APP_SECRET=your_meta_app_secret_here

# Client Business WhatsApp Phone Number (e.g. 263770000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=263770000000
